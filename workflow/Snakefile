    log:
        f"{NET}/genes/logs/plot_networks_de.log",
    conda:
        "envs/plots_r.yaml"
    params:
        study_of=STUDY_OF,
        max_adj_p=config["go"]["adj_pvalue"],
    script:
        "scripts/plot_networks_de.R"

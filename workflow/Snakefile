        f"{NET}/genes/logs/risk_genes.log",
    conda:
        "envs/data_wr.yaml"
    params:
        n_perm=config["permutation"]["n"],
        strata=config["permutation"]["strata"],
        seed=config["permutation"]["seed"],
    script:
        "scripts/risk_genes.R"


# Figure 2 (analyses 4 and 5) and Figure S4 (robustness of analysis 4):

    params:
        study_of=STUDY_OF,
    script:
        "scripts/plot_network_metrics.R"


# ---- Networks vs DE and risk genes (analyses 4, 5 and 7) ---------------------
# Inputs: the matched networks (analysis 1) and the DE tables.
# Outputs in {NET}/genes/


# Analysis 4, step 1: neighbor change of each gene, AD_repk vs CT_all
rule gene_rewiring:
    input:
        networks=lambda w: [f for f in NET_MATCHED if f"/matched/{w.region}/" in f],
        de=lambda w: f"{config['de_source']}/{STUDY_OF[w.region]}_Differential_Expression_(diagnosis).tsv",
        network_utils="workflow/scripts/R/network_utils.R",
        de_utils="workflow/scripts/R/de_utils.R",
    output:
        genes=f"{NET}/genes/rewiring/{{region}}.tsv",
        replicates=f"{NET}/genes/rewiring/{{region}}_replicates.tsv",
    log:
        f"{NET}/genes/logs/gene_rewiring_{{region}}.log",
    conda:
        "envs/network_analysis.yaml"
    params:
        adj_p=config["de"]["adj_pvalue"],
        fold_change=config["de"]["fold_change"],
    script:
        "scripts/gene_rewiring.R"


# Analysis 4: rewired genes x DE, four groups of genes, sensitivity and stability
rule rewiring_vs_de:
    input:
        genes=expand(f"{NET}/genes/rewiring/{{region}}.tsv", region=REGIONS),
        replicates=expand(
            f"{NET}/genes/rewiring/{{region}}_replicates.tsv", region=REGIONS
        ),
        de_utils="workflow/scripts/R/de_utils.R",
    output:
        genes=f"{NET}/genes/rewiring_genes.tsv",
        tests=f"{NET}/genes/rewiring_tests.tsv",
        replicates=f"{NET}/genes/rewiring_replicates.tsv",
        robust=f"{NET}/genes/rewiring_robust.tsv",
    log:
        f"{NET}/genes/logs/rewiring_vs_de.log",
    conda:
        "envs/data_wr.yaml"
    params:
        min_degree=config["de"]["min_degree"],
        top_rewired=config["de"]["top_rewired"],
        sensitivity=config["de"]["top_rewired_sensitivity"],
        min_replicates=config["de"]["min_replicates"],
        n_perm=config["permutation"]["n"],
        strata=config["permutation"]["strata"],
        seed=config["permutation"]["seed"],
    script:
        "scripts/rewiring_vs_de.R"


# Analysis 4: GO enrichment of the "rewired only" genes of each region
rule go_rewired:
    input:
        genes=f"{NET}/genes/rewiring_genes.tsv",
    output:
        f"{NET}/genes/rewiring_go.tsv",
    log:
        f"{NET}/genes/logs/go_rewired.log",
    conda:
        "envs/enrichment.yaml"
    params:
        ontology=config["go"]["ontology"],
        min_size=config["go"]["min_size"],
        max_size=config["go"]["max_size"],
        max_adj_p=config["go"]["adj_pvalue"],
    script:
        "scripts/go_rewired.R"


# Analysis 5: shared, gained and lost hubs, and hub type x DE
rule hubs:
    input:
        networks=NET_MATCHED,
        de=DE_FILES,
        network_utils="workflow/scripts/R/network_utils.R",
        de_utils="workflow/scripts/R/de_utils.R",
    output:
        genes=f"{NET}/genes/hubs_genes.tsv",
        tests=f"{NET}/genes/hubs_tests.tsv",
    log:
        f"{NET}/genes/logs/hubs.log",
    conda:
        "envs/network_analysis.yaml"
    params:
        study_of=STUDY_OF,
        adj_p=config["de"]["adj_pvalue"],
        fold_change=config["de"]["fold_change"],
        top_pagerank=config["hubs"]["top_pagerank"],
        min_replicates=config["hubs"]["min_replicates"],
        max_replicates_lost=config["hubs"]["max_replicates_lost"],
        n_perm=config["permutation"]["n"],
        strata=config["permutation"]["strata"],
        seed=config["permutation"]["seed"],
    script:
        "scripts/hubs.R"


# Analysis 7: AD risk genes among the rewired genes and the gained and lost hubs
rule risk_genes:
    input:
        risk=config["risk_genes"],
        rewiring=f"{NET}/genes/rewiring_genes.tsv",
        hubs=f"{NET}/genes/hubs_genes.tsv",
